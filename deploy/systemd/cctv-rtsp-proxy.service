[Unit]
Description=CCTV loopback RTSP credential relay
After=network-online.target
Wants=network-online.target
OnFailure=cctv-alert@%N.service

[Service]
Type=simple
User=cctv
Group=cctv
Environment=CCTV_CONFIG_DIR=/etc/cctv
Environment=CCTV_PROXY_CAMERA_CONFIG=/run/cctv/cameras.proxy.json
RuntimeDirectory=cctv
RuntimeDirectoryMode=0750
ExecStart=/opt/cctv/venv/bin/cctv-rtsp-proxy
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/cctv
UMask=0077

[Install]
WantedBy=multi-user.target
