# .env для docker compose (рядом с compose.yml). Обязателен только токен: владельца
# и группу назначает мастер (код в docker logs → /start <код>, затем бот в группу).
CCTV_BOT_TOKEN=
# CCTV_CHAT_ID=                      # задать вручную — сильнее мастера
# CCTV_ALLOWED_USER_IDS=
# CCTV_OWNER_IDS=                    # личка об авариях; по умолчанию allowed
# CCTV_LANG=ru                       # язык установки (en, ru): бот, сводка, healthcheck;
#                                    # не задан — язык Telegram владельца, иначе en

# Каталог конфига (config.toml, cameras.json, secrets.toml). Нет cameras.json —
# движок стартует без камер; добавили файл — цепочка перезапустится сама.
# Файлы должны читаться пользователем контейнера (uid 10001).
# CCTV_CONFIG_PATH=./config

# Порты на хосте (network_mode: host). Рядом с другой установкой — развести.
# CCTV_BRIDGE_PORT=8780
# CCTV_EVENTS_PORT=8781
# CCTV_RTSP_PROXY_PORT=28554         # +1 на каждый поток камеры

# RAM под видео: tmpfs буфера и транзита; лимит буфера — на камеру.
# CCTV_BUFFER_TMPFS=2g
# CCTV_BUFFER_MAX_BYTES=419430400
# CCTV_SPOOL_TMPFS=512m
# CCTV_STORAGE_BUDGET_BYTES=2684354560
# CCTV_BOT_RUNTIME_TMPFS=128m        # загрузки бота: не меньше лимита клипа (48 МиБ)

# COMPOSE_PROJECT_NAME=dozorcam      # второй экземпляр на узле — другое имя
# CCTV_IMAGE=ghcr.io/egorchenkov/dozorcam   # имя образа (свой реестр или локальная сборка)
# CCTV_IMAGE_TAG=latest              # или версия: 0.1.0
