# .env для docker compose (рядом с compose.yml). Обязателен только токен: владельца
# и группу назначает мастер (код в docker logs → /start <код>, затем бот в группу).
CCTV_BOT_TOKEN=
# CCTV_CHAT_ID=                      # задать вручную — сильнее мастера
# CCTV_ALLOWED_USER_IDS=
# CCTV_OWNER_IDS=                    # личка об авариях; по умолчанию allowed
# CCTV_LANG=ru                       # язык установки (en, ru): бот, сводка, healthcheck;
#                                    # не задан — язык Telegram владельца, иначе en
# CCTV_TZ=Europe/Berlin              # часовой пояс подписей и суток сводки (IANA);
#                                    # не задан — UTC и предупреждение в «Пульте»
# CCTV_EVENT_MERGE_SEC=60            # события камеры за столько секунд — одним постом
#                                    # («+N за минуту», свежий кадр); 0 — каждое отдельно
# CCTV_UPDATE_CHECK=0                # не спрашивать GitHub Releases о новой версии (раз в
#                                    # сутки; строка «Доступна X» на карте и в /version)

# CCTV_TELEGRAM_API=http://127.0.0.1:8081   # свой сервер telegram-bot-api; пусто — api.telegram.org
# CCTV_UPDATE_URL=                   # адрес releases/latest для проверки версии; пусто — GitHub

# CCTV_NODE=dacha                    # имя этого узла, если узлов несколько (раздел [failover]
#                                    # config.toml, docs/failover.md); один узел — не нужно

# Каталог конфига (config.toml, cameras.json, secrets.toml). Нет cameras.json —
# движок стартует без камер; добавили файл — цепочка перезапустится сама.
# Файлы должны читаться пользователем контейнера (uid 10001).
# CCTV_CONFIG_PATH=./config

# Порты на хосте (network_mode: host). Рядом с другой установкой — развести.
# CCTV_BRIDGE_PORT=8780
# CCTV_EVENTS_PORT=8781
# CCTV_RTSP_PROXY_PORT=28554         # +1 на каждый поток камеры

# RAM под видео: tmpfs буфера и транзита; лимит буфера — на камеру (поток).
# CCTV_BUFFER_TMPFS=2g
# CCTV_BUFFER_MAX_BYTES=419430400
# Буфер на диске (SSD), если RAM мало: каталог в контейнере и, по желанию, каталог хоста
# (владелец uid 10001); пусто — том engine-buffer. После правки — dozorcam restart.
# CCTV_BUFFER_DIR=/var/lib/cctv/buffer-disk
# CCTV_BUFFER_DISK=/mnt/ssd/dozorcam
# CCTV_SPOOL_TMPFS=512m
# CCTV_STORAGE_BUDGET_BYTES=2684354560
# CCTV_BOT_RUNTIME_TMPFS=128m        # загрузки бота: не меньше лимита клипа (48 МиБ)

# NPU Rockchip для детектора людей: обёртка dozorcam находит узлы сама
# (/dev/dri/by-path/*npu-card, *npu-render или /dev/rknpu) и передаёт их движку; вручную —
# только если узлы называются иначе (номера групп — stat -c %g <узел>). Без NPU — пусто.
# CCTV_NPU_CARD=/dev/dri/card1
# CCTV_NPU_RENDER=/dev/dri/renderD129
# CCTV_NPU_CARD_GID=44
# CCTV_NPU_RENDER_GID=991

# Intel iGPU для бэкенда openvino (образ с тегом -openvino): обёртка находит render-узел
# i915/xe сама и передаёт движку /dev/dri с группой узла. Без iGPU — пусто.
# CCTV_INTEL_DRI=/dev/dri
# CCTV_INTEL_RENDER_GID=992

# COMPOSE_PROJECT_NAME=dozorcam      # второй экземпляр на узле — другое имя
# CCTV_IMAGE=ghcr.io/egorchenkov/dozorcam   # имя образа (свой реестр или локальная сборка)
# CCTV_IMAGE_TAG=latest              # или версия: 0.1.0
